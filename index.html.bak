<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jailbreak Amine PS4</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            width: 100vw;
            /* قراءة الصورة من نفس المجلد */
            background-image: url('background.png'); 
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            overflow: hidden;
            background-color: #121212;
        }
        #result, #user-agent {
            display: none;
        }
    </style>
  <link rel="stylesheet" href="theme.css">
</head>
<body>

    <audio id="bg-music" src="../music_background.mp3" autoplay loop></audio>

    <div id="result"></div>
    <div id="user-agent"></div>

    <script>
        function processDevice() {
            const audio = document.getElementById('bg-music');
            if (audio) {
                audio.play().catch(function(error) {
                    console.log("Autoplay hindered.");
                });
            }

            const userAgent = navigator.userAgent;
            const isPS4 = /PlayStation 4|PS4/i.test(userAgent);
            
            if (isPS4) {
                const fwMatch = userAgent.match(/(?:PlayStation 4|PS4)[\s\/]+([\d\.]+)/i);
                if (fwMatch && fwMatch[1]) {
                    const firmware = parseFloat(fwMatch[1]);
                    
                    /* تم ضبط التوقيت هنا على 15000 مللي ثانية (أي 15 ثانية تماماً) */
                    if (Math.abs(firmware - 9.00) < 0.001) { setTimeout(() => { window.location.href = "900/index.html"; }, 1000); } else if (firmware >= 5.00 && firmware <= 9.60) {
                        setTimeout(() => { window.location.href = "505_960/index.html"; }, 10000);
                    } else if (firmware >= 10.00 && firmware <= 11.02) {
                        setTimeout(() => { window.location.href = "1000_1102/index.html"; }, 10000);
                    } else if (firmware >= 11.50 && firmware <= 13.00) {
                        setTimeout(() => { window.location.href = "1150-1300/index.html"; }, 10000);
                    }
                }
            }
        }
        window.onload = processDevice;
    </script>
<script>

/* Firmware Auto Start dispatcher */
(function () {
  "use strict";
  function fw() {
    var t = (document.body && document.body.innerText) || "";
    var m = t.match(/(9\.00|9\.03|9\.04|9\.50|9\.60|10\.00|10\.01|10\.50|10\.70|10\.71|11\.00|11\.02|11\.50|11\.51|11\.52|11\.60|11\.70|11\.80|12\.00|12\.50|12\.70|12\.71|12\.72|13\.00)/);
    return m ? m[1] : null;
  }
  function start() {
    var selectors = [
      "#startJailbreak","#start-jailbreak","#start","#jeilbrek",
      "[data-action='jailbreak']",
      "button[id*='start' i][id*='jailbreak' i]",
      "a[id*='start' i][id*='jailbreak' i]"
    ];
    for (var i=0;i<selectors.length;i++) {
      var e=document.querySelector(selectors[i]);
      if(e && !e.disabled){ try{e.click(); return true;}catch(_){} }
    }
    return false;
  }
  window.FirmwareAutoStart = { firmware: fw(), start: start };
  if(document.readyState==="loading")
    document.addEventListener("DOMContentLoaded",function(){setTimeout(start,300);});
  else setTimeout(start,300);
})();

</script>
</body>
</html>
